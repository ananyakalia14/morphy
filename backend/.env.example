MORPHY_SUPABASE_URL=http://127.0.0.1:55421
MORPHY_SUPABASE_PUBLIC_KEY=
MORPHY_CONTROL_DSN=
# Generate once with python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MORPHY_ENCRYPTION_KEY=
# Explicit approved target endpoints, comma separated. Never use a wildcard.
MORPHY_TARGET_HOSTS=127.0.0.1:5432
MORPHY_OLLAMA_URL=http://127.0.0.1:11434
MORPHY_OLLAMA_MODEL=qwen2.5-coder:7b
# Optional exact-question SQL cache. The server falls back when Redis is unavailable.
MORPHY_REDIS_URL=
# Optional Redis Search index for permitted schema embeddings (requires Redis Search).
MORPHY_REDIS_SEMANTIC=0
# Separate, private stream destination for python -m app.engine.audit_worker.
MORPHY_AUDIT_REDIS_URL=
# Optional UDP port of a DogStatsD agent on the same host. Off by default.
MORPHY_DOGSTATSD_PORT=
# auto uses cached MiniLM weights if installed. off uses lexical schema retrieval.
MORPHY_EMBEDDINGS=auto
